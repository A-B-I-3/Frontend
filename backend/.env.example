# Copy to .env and fill in real values.

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Postgres
DATABASE_URL=postgresql://postgres:12345@localhost:5432/ai_interview

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Email — this project ships with a console-log stub (see src/utils/mailer.js).
# Swap in a real provider (SES, SendGrid, Postmark, etc.) before going to production.
MAIL_FROM=no-reply@example.com
